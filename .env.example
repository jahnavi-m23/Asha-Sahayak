# .env.example
# ASHA SAHAYAK - Environment Configuration

# Application settings
APP_NAME="ASHA SAHAYAK - AI Understanding & Safety Backend"
DEBUG=false
ENVIRONMENT=development

# Qwen AI Configuration
# Key for Qwen API (DashScope / Alibaba Cloud or OpenAI-compatible endpoint)
QWEN_API_KEY=""
QWEN_API_BASE="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL_NAME="qwen-plus"
QWEN_TIMEOUT_SECONDS=25.0

# Gnani Timbre v3.0 Text-to-Speech Configuration
GNANI_API_KEY=""
GNANI_TOKEN=""
GNANI_TIMBRE_URL="https://api.gnani.ai/timbre/v3/synthesize"
GNANI_TIMEOUT_SECONDS=15.0

# Phase 3 Shared Backend Integration
PHASE_3_ENDPOINT_URL="http://localhost:8000/api/records/save"
PHASE_3_API_KEY=""

# Public Health Safety & Offline Testing
ALLOW_MOCK_FALLBACK=true
REQUIRE_EXPLICIT_CONFIRMATION=true
DEFAULT_LANGUAGE="kn-en"
