# ==============================================================================
# ASHA SAHAYAK - Phase 1 Voice Recognition & Speech Synthesis Configuration
# ==============================================================================

# Gnani API Credentials (https://gnani.ai)
# Store your real API key here. NEVER commit your actual API key to git.
GNANI_API_KEY=your_new_api_key                                                                                                                                                                                                                                ----------
# Speech-To-Text (STT): Gnani Prisma v3.0
# ------------------------------------------------------------------------------
GNANI_WEBSOCKET_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_MODEL=prisma-v3.0

# Supported STT Languages:
# Single: hi-IN, kn-IN, en-IN, ta-IN, te-IN, ml-IN, mr-IN, bn-IN, gu-IN, pa-IN
# Automatic Language Detection: indic-auto
# Code-mixed: kn-IN,en-IN or hi-IN,en-IN
GNANI_DEFAULT_LANGUAGE=indic-auto

# ------------------------------------------------------------------------------
# Text-To-Speech (TTS): Gnani Timbre v2.5
# ------------------------------------------------------------------------------
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_DEFAULT_VOICE=Kavya
GNANI_TTS_DEFAULT_LANGUAGE=kn-IN

# ------------------------------------------------------------------------------
# Server & CORS Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
